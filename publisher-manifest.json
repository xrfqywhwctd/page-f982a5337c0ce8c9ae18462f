head th:nth-child(3){background:rgba(198,255,46,.045)}\n  .yes{color:var(--lime);font-weight:600}\n  .no{color:#6c726c}\n  .plans-foot{margin-top:20px;color:#9aa09b;font-size:13.5px;max-width:56em}\n\n  /* ---------- BREW GUIDE ---------- */\n  .brew{background:var(--ink-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n  .brew-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px}\n  .brew-card{background:var(--ink-3);border:1px solid var(--line);border-radius:22px;box-shadow:0 18px 44px -30px rgba(0,0,0,.9);padding:26px 24px}\n  .brew-card .mono{color:var(--lime);display:block;margin-bottom:12px}\n  .brew-card h3{font-size:19px;margin-bottom:10px}\n  .brew-card p{color:#aab0aa;font-size:14.5px}\n  .brew-card ul{margin:14px 0 0;padding-left:18px;color:#dfe4d8;font-size:14.5px}\n  .brew-card li{margin-bottom:6px}\n  .brew-card li::marker{color:var(--lime)}\n\n  /* ---------- FAQ ---------- */\n  .faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px 40px}\n  .qa{border-top:1px solid var(--line);padding:22px 0 6px}\n  .qa h3{font-size:16.5px;margin-bottom:8px;display:grid;grid-template-columns:auto 1fr;gap:10px}\n  .qa h3 .q{font-family:\"SFMono-Regular\",Consolas,monospace;font-size:12px;color:var(--lime);padding-top:3px}\n  .qa p{color:#aeb4ae;font-size:14.5px;padding-left:26px}\n\n  /* ---------- ORDER / CTA ---------- */\n  .order{background:var(--ink-2);border-top:1px solid var(--line)}\n  .order-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:start}\n  .order h2{font-size:clamp(24px,3.2vw,34px);font-weight:800}\n  .order p{margin-top:14px;color:#b9bfb9;font-size:15.5px;max-width:32em}\n  .order-steps{margin:26px 0 0;padding:0;list-style:none;counter-reset:o}\n  .order-steps li{counter-increment:o;display:grid;grid-template-columns:34px 1fr;gap:12px;padding:12px 0;border-top:1px solid var(--line);font-size:14.5px}\n  .order-steps li::before{content:counter(o,decimal-leading-zero);font-family:\"SFMono-Regular\",Consolas,monospace;font-size:12px;color:var(--lime);padding-top:3px}\n  .order-steps li b{display:block;margin-bottom:2px}\n  .order-steps li span{color:#a4aaa4;font-size:13.5px}\n\n  /* ---------- FOOTER ---------- */\n  footer{border-top:1px solid var(--line);padding:34px 0 44px;background:var(--ink)}\n  .foot-grid{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:flex-start}\n  .foot-brand{font-size:15px;font-weight:700}\n  .foot-brand span{display:block;font-weight:400;color:var(--muted);font-size:13px;margin-top:6px}\n  .foot-links{display:flex;gap:20px;flex-wrap:wrap}\n  .foot-links a{color:var(--muted);text-decoration:none;font-size:13px;border-bottom:1px solid transparent}\n  .foot-links a:hover{color:var(--lime);border-bottom-color:var(--lime)}\n  .foot-note{margin-top:24px;padding-top:18px;border-top:1px solid var(--line);color:#7d837d;font-size:12.5px}\n\n  /* ---------- RESPONSIVE ---------- */\n  @media (max-width:960px){.hero-grid{grid-template-columns:1fr;gap:36px;padding:48px 0 56px}\n    .shelf-grid{grid-template-columns:1fr}\n    .brew-grid,.faq-grid,.order-grid{grid-template-columns:1fr}\n    section{padding:58px 0}}\n  @media (max-width:560px){\n    .wrap{padding:0 16px}\n    .hero-facts{gap:22px}\n    .hero h1{font-size:clamp(34px,9vw,46px)}\n    .nav-tabs a{padding:6px 11px;font-size:12px}\n    .panel{padding:22px 18px;border-radius:20px}\n  }\n</style><header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-top\">\n      <div class=\"brandmark\">\n        <span class=\"dot\"></span>\n        <span class=\"name\">下北沢红茶馆</span>\n      </div>\n      <nav class=\"nav-tabs\" aria-label=\"页面锚点\">\n        <a href=\"#tea-shelf\">茶架</a>\n        <a href=\"#plans\">月度配给</a>\n        <a href=\"#brew\">冲煮</a>\n        <a href=\"#faq\">疑问</a>\n        <a href=\"#order\">订阅</a>\n      </nav>\n    </div>\n\n    <div class=\"hero-grid\">\n      <div>\n        <p class=\"kicker mono\">红茶 · 按月配给 · 冲煮笔记</p>\n        <h1>下北沢红茶馆 · 一杯红茶，<br>泡得<em>慢</em>一点。</h1>\n        <p class=\"hero-lede\">下北沢红茶馆不做炫技的茶。我们把茶叶按月份分好，附上水温、克数、秒数，寄到你手里。剩下的时间交给你自己。</p>\n        <p class=\"hero-lede\">茶单每月换一次。当季叶子的香气会变，配给你的冲煮参数也会跟着调。</p>\n\n        <div class=\"hero-facts\">\n          <div><b>三档</b><span>配给规格</span></div>\n          <div><b>每月</b><span>茶单更新</span></div>\n          <div><b>随箱</b><span>冲煮卡片</span></div>\n        </div>\n      </div>\n\n      <aside class=\"panel\" aria-label=\"开箱后怎么泡\">\n        <h2>开箱之后</h2>\n        <ol>\n          <li>\n            <span><b>先看卡片</b><span>每款茶的水温与时间都写在卡片上，按它来。</span></span>\n          </li>\n          <li>\n            <span><b>称三克</b><span>一人份大约三克，配两百毫升水。粗叶多给一点。</span></span>\n          </li>\n          <li>\n            <span><b>水别滚着倒</b><span>沸水静置一两分钟。嫩叶更怕烫。</span></span>\n          </li>\n          <li>\n            <span><b>记一笔</b><span>写上今天喝到的是甜、涩还是木质，下次好调。</span></span>\n          </li>\n        </ol>\n        <p class=\"panel-note\">第一次订阅会多寄一张空白冲煮记录卡。攒满十二张，你就有自己的茶谱了。</p>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"shelf\" id=\"tea-shelf\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"mono\">01 / 茶架</span>\n        <h2>这个月茶架上的三只罐子</h2>\n        <p>逐月轮换。每只罐子标注产区、处理方式与建议水温，不做风味夸张的描述，只写喝起来的方向。</p>\n      </div>\n\n      <div class=\"shelf-grid\">\n        <article class=\"tea\">\n          <span class=\"no\">TIN 01</span>\n          <h3>阿萨姆 · 春摘</h3>\n          <p>叶形完整，汤色偏红。入口厚，尾段带一点麦芽的甜，冷了以后会显涩。</p>\n          <dl>\n            <dt>建议水温</dt><dd>95℃</dd>\n            <dt>投茶量</dt><dd>3g / 200ml</dd>\n            <dt>浸泡</dt><dd>3 分 30 秒</dd>\n            <dt>适合</dt><dd>加奶，或早晨第一杯</dd>\n          </dl>\n        </article>\n\n        <article class=\"tea\">\n          <span class=\"no\">TIN 02</span>\n          <h3>大吉岭 · 次摘</h3>\n          <p>香气比味道更靠前。有一点点熟果和麝香葡萄的方向，茶体轻，别泡过头。</p>\n          <dl>\n            <dt>建议水温</dt><dd>92℃</dd>\n            <dt>投茶量</dt><dd>2.5g / 200ml</dd>\n            <dt>浸泡</dt><dd>3 分</dd>\n            <dt>适合</dt><dd>清饮，下午配点心</dd>\n          </dl>\n        </article>\n\n        <article class=\"tea\">\n          <span class=\"no\">TIN 03</span>\n          <h3>祁门 · 工夫</h3>\n          <p>条索细，汤色橙红。喝起来圆，回甘慢，第二泡往往比第一泡稳。</p>\n          <dl>\n            <dt>建议水温</dt><dd>90℃</dd>\n            <dt>投茶量</dt><dd>3g / 200ml</dd>\n            <dt>浸泡</dt><dd>2 分 45 秒</dd>\n            <dt>适合</dt><dd>清饮，可复泡两次</dd>\n          </dl>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"plans\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"mono\">02 / 月度配给</span>\n        <h2>三档配给，横向对比</h2>\n        <p>区别只在茶叶克数与随箱内容，冲煮卡片和记录卡三档都有。不用抢，也不用升舱。</p>\n      </div>\n\n      <div class=\"table-scroll\">\n        <table>\n          价格与含项以页面当前所示为准；年付为按月价折算的年度总价。\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>\n                基础版\n                <span class=\"price\">¥15 <small>/ 月</small></span>\n                <span class=\"annual\">按年付 ¥150 / 年</span>\n              </th>\n              <th>\n                <span class=\"tag\">常选</span>\n                旗舰版\n                <span class=\"price\">¥35 <small>/ 月</small></span>\n                <span class=\"annual\">按年付 ¥350 / 年</span>\n              </th>\n              <th>\n                团队版\n                <span class=\"price\">¥85 <small>/ 月</small></span>\n                <span class=\"annual\">按年付 ¥850 / 年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>每月茶叶量</th>\n              <td>约 100 克</td>\n              <td>约 300 克</td>\n              <td>约 1000 克</td>\n            </tr>\n            <tr>\n              <th>每月茶款数量</th>\n              <td>1 款</td>\n              <td>3 款</td>\n              <td>3 款 + 一款加量</td>\n            </tr>\n            <tr>\n              <th>冲煮卡片</th>\n              <td class=\"yes\">含</td>\n              <td class=\"yes\">含</td>\n              <td class=\"yes\">含</td>\n            </tr>\n            <tr>\n              <th>空白冲煮记录卡</th>\n              <td>首月寄出</td>\n              <td>首月寄出</td>\n              <td>首月寄出，可加订</td>\n            </tr>\n            <tr>\n              <th>可分享账号数</th>\n              <td>3 人</td>\n              <td>5 人</td>\n              <td>20 人</td>\n            </tr>\n            <tr>\n              <th>换茶申请</th>\n              <td>每季度一次</td>\n              <td>每月一次</td>\n              <td>每月一次，另可指定茶款</td>\n            </tr>\n            <tr>\n              <th>冲泡咨询</th>\n              <td class=\"no\">—</td>\n              <td class=\"yes\">优先回复</td>\n              <td class=\"yes\">专属对接人</td>\n            </tr>\n            <tr>\n              <th>适合场景</th>\n              <td>一个人，一天一两杯</td>\n              <td>两三个人喝，或每天都喝</td>\n              <td>办公室、茶桌、常招待客人</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"plans-foot\">“可分享账号数”指同一订阅下可以登记的人数，用于领取冲煮咨询与换茶申请，不涉及任何软件或网络服务。</p>\n    </div>\n  </section>\n\n  <section class=\"brew\" id=\"brew\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"mono\">03 / 冲煮</span>\n        <h2>三件事，决定这杯茶好不好喝</h2>\n        <p>不用买一整套设备。一只杯子、一杆小秤、一个能读秒的东西，就够开始。</p>\n      </div>\n\n      <div class=\"brew-grid\">\n        <article class=\"brew-card\">\n          <span class=\"mono\">水温</span>\n          <h3>沸水不是万能水</h3>\n          <p>水开以后先倒进公道杯，静置一至两分钟，大约落到 90℃ 上下。嫩叶怕烫，粗叶怕凉。</p>\n          <ul>\n            <li>95℃：阿萨姆这类叶厚、想要厚度的茶。</li>\n            <li>90–92℃：大吉岭、祁门这类香气靠前的茶。</li>\n            <li>没有温度计就看杯子：手贴杯壁能停三秒，差不多。</li>\n          </ul>\n        </article>\n\n        <article class=\"brew-card\">\n          <span class=\"mono\">比例</span>\n          <h3>先固定水，再调茶</h3>\n          <p>固定两百毫升水，茶量在三克附近微调。茶多了就短一点时间，别两头一起改。</p>\n          <ul>\n            <li>觉得太涩：减半克茶，或缩短三十秒。</li>\n            <li>觉得太淡：先加半克茶，不要急着延长浸泡。</li>\n            <li>第二泡通常比第一泡短，因为叶子已经展开。</li>\n          </ul>\n        </article>\n\n        <article class=\"brew-card\">\n          <span class=\"mono\">记录</span>\n          <h3>写下来，比记性好用</h3>\n          <p>喝完三十秒再写。那会儿嘴里的余味最清楚，甜、涩、干、木质，随便挑一个词。</p>\n          <ul>\n            <li>记三项就够：水温、克数、秒数。</li>\n            <li>加一句主观判断，比如“下次短一点”。</li>\n            <li>攒满十二张，你能看出自己偏好哪种倾向。</li>\n          </ul>\n        </article>\n\n        <article class=\"brew-card\">\n          <span class=\"mono\">存放</span>\n          <h3>茶叶怕三样东西</h3>\n          <p>光、湿气、异味。罐子放在柜子里，别挨着香料和咖啡豆，它们会比茶先说话。</p>\n          <ul>\n            <li>开封后尽量在六到八周内喝完。</li>\n            <li>不用冷藏，反复取放反而容易返潮。</li>\n            <li>罐口封严，取茶用干勺。</li>\n          </ul>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"mono\">04 / 疑问</span>\n        <h2>常被问到的八个问题</h2>\n        <p>答案写在这里，不用发消息问。真没找到，再联系我们。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q1</span>每月寄来的是同一款茶吗？</h3>\n          <p>不是。茶单每月轮换，基础版寄一款，旗舰版与团队版寄三款。具体茶款在当月的茶单里公布，以实际寄出为准。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q2</span>三档的差别到底在哪？</h3>\n          <p>只在茶叶量、茶款数量和可登记的人数上。冲煮卡片三档都有，泡法说明没有任何删减。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q3</span>可以随时换一档吗？</h3>\n          <p>可以。下一期生效，改动不追溯已经寄出的月份。年付用户同样适用。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q4</span>拿到茶不会泡怎么办？</h3>\n          <p>每款茶都附一张卡片，写着水温、克数、秒数。按卡片来，第一次就有个像样的结果。旗舰版与团队版还可以就具体问题申请咨询。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q5</span>能不能指定某一款茶？</h3>\n          <p>团队版可以提出指定要求，其它档位按当月茶单寄出。每月换茶申请的次数见上方对比表。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q6</span>“可分享账号数”是什么？</h3>\n          <p>指同一订阅下可以登记的人数，用于领取冲煮咨询和提交换茶申请。它不涉及任何软件账号、网络服务或设备授权。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q7</span>茶叶怎么保存？</h3>\n          <p>避光、干燥、远离异味。罐口封严，开封后尽量在六到八周内喝完。不建议冷藏，反复取放容易返潮。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q8</span>寄送范围与时间怎么确认？</h3>\n          <p>页面不承诺具体范围与到达时效。下单前请以订阅页当前展示的寄送说明为准，那里会写清楚当期可寄的区域。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"order\" id=\"order\">\n    <div class=\"wrap order-grid\">\n      <div>\n        <h2>想开始的话，从一杯开始。</h2>\n        <p>先订一个月，喝完再决定要不要继续。我们不设自动续期以外的花招，也不催你升级。</p>\n        <p>如果你还不确定自己喝得惯哪一种，从基础版起步，一个月一款，慢慢认路。</p>\n      </div>\n      <div>\n        <ol class=\"order-steps\">\n          <li>\n            <span><b>挑一档</b><span>对照上面的表格，选适合你喝茶频率的那一档。</span></span>\n          </li>\n          <li>\n            <span><b>填写收件信息</b><span>在订阅页填写姓名与收件地址，请填写可长期收件的地址。</span></span>\n          </li>\n          <li>\n            <span><b>等箱子</b><span>当期茶单确认后寄出，箱内有茶、卡片与记录卡。</span></span>\n          </li>\n          <li>\n            <span><b>泡第一杯</b><span>照卡片的水温与秒数来，然后把结果写下来。</span></span>\n          </li>\n        </ol>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div class=\"foot-brand\">\n        下北沢红茶馆\n        <span>红茶按月配给 · 冲煮笔记</span>\n      </div>\n      <div class=\"foot-links\">\n        <a href=\"#tea-shelf\">茶架</a>\n        <a href=\"#plans\">月度配给</a>\n        <a href=\"#brew\">冲煮</a>\n        <a href=\"#faq\">疑问</a>\n        <a href=\"#order\">订阅</a>\n      </div>\n    </div>\n    <p class=\"foot-note\">页面所示价格与含项以订阅页当前展示为准。茶叶风味因人而异，冲煮参数为建议值，请按实际口感调整。</p>\n  </div>\n</footer>",
